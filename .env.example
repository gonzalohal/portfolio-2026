# Variables de entorno necesarias en Vercel (Project Settings → Environment Variables)
# No completar acá — este archivo es solo referencia y SI se commitea (sin valores reales).

# Token de GitHub (fine-grained, permiso "Contents: Read and write" SOLO en el repo gonzalohal/portfolio)
GITHUB_TOKEN=

# Datos del repo (default ya apuntan a gonzalohal/portfolio / main)
GITHUB_OWNER=gonzalohal
GITHUB_REPO=portfolio
GITHUB_BRANCH=main

# Contraseña del panel de administración
ADMIN_PASSWORD=

# String aleatorio largo para firmar la sesión (generar uno propio, no reusar este ejemplo)
SESSION_SECRET=
